+    overlay = lv_refr_get_top_obj(&layer->_clip_area, lv_display_get_layer_top(disp_refr));
+    if(overlay) {
+        refr_obj_and_children(layer, overlay);
+        refr_obj_and_children(layer, lv_display_get_layer_sys(disp_refr));
+        LV_PROFILER_REFR_END;
